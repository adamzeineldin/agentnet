{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NIMBOTICS_DB_PATH=backend/app/data/demo/nimbotics.db",
        "NIMBOTICS_ARTIFACT_DIR=backend/app/data/demo/artifacts",
        "backend/.venv/bin/uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-cloud-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NIMBOTICS_SESSION_SECRET=",
        "GOOGLE_CLIENT_ID=",
        "GOOGLE_CLIENT_SECRET=",
        "GITHUB_CLIENT_ID=",
        "GITHUB_CLIENT_SECRET=",
        "DATABASE_URL=postgresql://nimbotics:nimbotics@localhost:5433/nimbotics",
        "NIMBOTICS_S3_ENDPOINT=http://localhost:9000",
        "NIMBOTICS_S3_BUCKET=nimbotics",
        "NIMBOTICS_S3_ACCESS_KEY_ID=nimbotics",
        "NIMBOTICS_S3_SECRET_ACCESS_KEY=nimbotics-dev-secret",
        "NIMBOTICS_ARTIFACT_DIR=backend/app/data/cloud-cache/artifacts",
        "NIMBOTICS_UPLOAD_DIR=backend/app/data/cloud-cache/uploads",
        "backend/.venv/bin/uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "port": 8010
    }
  ]
}
