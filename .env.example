# Copy to .env (never commit .env).
# Meta Model API key. Leave empty to run with the clearly-labelled offline deterministic planner.
MODEL_API_KEY=
# muse-spark-1.3: $1.25/$4.25 per 1M tokens. muse-spark-1.3-contributor: $0.10/$0.20, but Meta may
# train on the traffic (AgentNet sends only simulated robot/task data). See DECISIONS.md D56.
META_MODEL_ID=muse-spark-1.3

# Optional overrides
# AGENTNET_DB_PATH=backend/app/data/agentnet.db
# AGENTNET_ARTIFACT_DIR=backend/app/data/artifacts
# AGENTNET_MENAGERIE_DIR=backend/app/data/menagerie

# Frontend -> backend URL
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
