# Copy to .env (never commit .env).
# Meta Model API key. Leave empty to run with the clearly-labelled offline deterministic planner.
MODEL_API_KEY=
# muse-spark-1.3: $1.25/$4.25 per 1M tokens. muse-spark-1.3-contributor: $0.10/$0.20, but Meta may
# train on the traffic (Nimbotics sends only simulated robot/task data). See DECISIONS.md D56.
META_MODEL_ID=muse-spark-1.3

# Sign-in (optional). With nothing set, anyone can start runs (fine locally). Setting NIMBOTICS_SESSION_SECRET turns
# on email + password accounts; Google / GitHub keys add those buttons. Once on, the Library stays open but the Lab,
# publishing skills, adding robots and writing on the blog need an account.
# Redirect URI to register with each provider: <public URL>/api/auth/callback/google (or /github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs session cookies; required when a provider is set. Generate with: openssl rand -hex 32
NIMBOTICS_SESSION_SECRET=
# Blog posts one writer may publish per UTC day (0 = no limit).
# NIMBOTICS_BLOG_DAILY_POSTS=20
# Local dev only: the pages run on :3000 and the API on :8000, so send people back to the pages after signing in.
# NIMBOTICS_APP_URL=http://localhost:3000
# Public origin used in redirect URIs when behind a proxy (unset = the request's own origin).
# NIMBOTICS_PUBLIC_URL=https://example.app.github.dev
# With a public URL set, its www. form redirects to it (e.g. www.nimbotics.net -> https://nimbotics.net).
# NIMBOTICS_PUBLIC_URL=https://nimbotics.net
# Cloud only (deploy/codespace.sh): token of a Cloudflare Tunnel that carries the public hostname to :7860.
# CLOUDFLARE_TUNNEL_TOKEN=

# Cloud Library (optional; see DECISIONS.md D95 and deploy/README.md). Unset = SQLite file + local folders.
# Postgres connection string, e.g. Neon's "postgresql://user:pass@host/db?sslmode=require".
# DATABASE_URL=
# S3-compatible bucket for run files and robot models, e.g. Cloudflare R2:
#   endpoint https://<account id>.r2.cloudflarestorage.com, keys from an R2 API token with Object Read & Write.
# NIMBOTICS_S3_ENDPOINT=
# NIMBOTICS_S3_BUCKET=
# NIMBOTICS_S3_ACCESS_KEY_ID=
# NIMBOTICS_S3_SECRET_ACCESS_KEY=
# Public address of the bucket (R2 custom domain or r2.dev URL); unset = 1-hour signed links. Leave it unset when
# people keep work private: a public bucket serves every file, private ones included, to anyone with the address.
# NIMBOTICS_S3_PUBLIC_URL=

# Optional overrides
# NIMBOTICS_DB_PATH=backend/app/data/nimbotics.db
# NIMBOTICS_ARTIFACT_DIR=backend/app/data/artifacts
# NIMBOTICS_UPLOAD_DIR=backend/app/data/uploads
# NIMBOTICS_MENAGERIE_DIR=backend/app/data/menagerie

# Frontend -> backend URL
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
