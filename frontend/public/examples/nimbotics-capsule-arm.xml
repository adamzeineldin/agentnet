<!-- An example six-joint arm made of capsules, for trying Nimbotics robot upload.
     It has no actuators and no keyframe on purpose: Nimbotics adds position servos and a home pose. -->
<mujoco model="capsule arm">
  <compiler angle="degree"/>
  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom rgba="0.82 0.84 0.88 1" density="800"/>
  </default>
  <worldbody>
    <body name="base">
      <geom type="cylinder" size="0.07 0.025" pos="0 0 0.025" rgba="0.25 0.27 0.3 1"/>
      <body name="shoulder" pos="0 0 0.05">
        <joint name="base_yaw" type="hinge" axis="0 0 1" range="-170 170"/>
        <geom type="capsule" fromto="0 0 0.05 0 0 0.12" size="0.045"/>
        <body name="upper_arm" pos="0 0 0.12">
          <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-110 110"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.30" size="0.04" rgba="0.93 0.45 0.25 1"/>
          <body name="forearm" pos="0 0 0.30">
            <joint name="elbow_pitch" type="hinge" axis="0 1 0" range="-150 150"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.28" size="0.035"/>
            <body name="wrist_1" pos="0 0 0.28">
              <joint name="wrist_roll" type="hinge" axis="0 0 1" range="-170 170"/>
              <geom type="capsule" fromto="0 0 0 0 0 0.06" size="0.03" rgba="0.93 0.45 0.25 1"/>
              <body name="wrist_2" pos="0 0 0.06">
                <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-120 120"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.05" size="0.028"/>
                <body name="flange" pos="0 0 0.05">
                  <joint name="flange_roll" type="hinge" axis="0 0 1" range="-170 170"/>
                  <geom type="cylinder" size="0.03 0.008" pos="0 0 0.008" rgba="0.25 0.27 0.3 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
